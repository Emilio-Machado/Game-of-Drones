<Project Sdk="Microsoft.NET.Sdk.Web">

	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<RootNamespace>Game_of_Drones</RootNamespace>
		<SpaRoot>Frontend\Web\</SpaRoot>
		<SpaDist>$(SpaRoot)dist\web\browser\</SpaDist>
	</PropertyGroup>

	<ItemGroup>
		<Compile Remove="Frontend\**" />
		<Content Remove="Frontend\**" />
		<EmbeddedResource Remove="Frontend\**" />
	</ItemGroup>

	<ItemGroup>
		<AngularBuildInput Include="$(SpaRoot)src\**\*" />
		<AngularBuildInput Include="$(SpaRoot)public\**\*" />
		<AngularBuildInput Include="$(SpaRoot)angular.json" />
		<AngularBuildInput Include="$(SpaRoot)package.json" />
		<AngularBuildInput Include="$(SpaRoot)package-lock.json" />
		<AngularBuildInput Include="$(SpaRoot)tsconfig*.json" />

		<UpToDateCheckInput Include="@(AngularBuildInput)" />
		<UpToDateCheckOutput Include="$(SpaDist)index.html" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.11" />
		<PackageReference Include="Microsoft.EntityFrameworkCore.Tools" Version="10.0.11">
			<PrivateAssets>all</PrivateAssets>
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
		</PackageReference>
		<PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
		<PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
	</ItemGroup>

	<Target Name="CheckNode" Condition="'$(DesignTimeBuild)' != 'true'">
		<Exec Command="node --version" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
			<Output TaskParameter="ExitCode" PropertyName="NodeExitCode" />
		</Exec>
		<Error
			Condition="'$(NodeExitCode)' != '0'"
			Text="Node.js is required to build the Angular frontend. Install a version supported by Angular 22 (22.22.3+, 24.15.0+, or 26+), restart Visual Studio, and try again." />

		<Exec Command="npm --version" IgnoreExitCode="true" StandardOutputImportance="Low" StandardErrorImportance="Low">
			<Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
		</Exec>
		<Error
			Condition="'$(NpmExitCode)' != '0'"
			Text="npm is required to build the Angular frontend. Install Node.js with npm, restart Visual Studio, and try again." />
	</Target>

	<Target
		Name="RestoreAngularDependencies"
		DependsOnTargets="CheckNode"
		Inputs="$(SpaRoot)package.json;$(SpaRoot)package-lock.json"
		Outputs="$(SpaRoot)node_modules\.package-lock.json"
		Condition="'$(DesignTimeBuild)' != 'true'">
		<Message Importance="high" Text="Restoring Angular dependencies with npm ci..." />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm ci" />
	</Target>

	<Target
		Name="BuildAngular"
		BeforeTargets="Build"
		DependsOnTargets="RestoreAngularDependencies"
		Condition="'$(DesignTimeBuild)' != 'true'">
		<Message Importance="high" Text="Building Angular frontend..." />
		<Exec WorkingDirectory="$(SpaRoot)" Command="npm run build" />
	</Target>

	<Target Name="IncludeAngularInPublish" AfterTargets="ComputeFilesToPublish">
		<ItemGroup>
			<AngularDistFiles Include="$(SpaDist)**\*" />
			<ResolvedFileToPublish Include="@(AngularDistFiles->'%(FullPath)')" Exclude="@(ResolvedFileToPublish)">
				<RelativePath>Frontend\Web\dist\web\browser\%(RecursiveDir)%(Filename)%(Extension)</RelativePath>
				<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
			</ResolvedFileToPublish>
		</ItemGroup>
	</Target>

</Project>
